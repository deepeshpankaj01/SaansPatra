# ==============================================================================
# SAANSPATRA (सांसपत्र) – ENVIRONMENT CONFIGURATION
# Civic Air Quality Intelligence & Policy Briefing Studio
# ==============================================================================
#
# Obtain a free Google Gemini API key at:
# https://aistudio.google.com/app/apikey
#
# LOCAL SETUP:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Paste your Gemini API key below:
#    GEMINI_API_KEY=AIzaSy...
# 3. (Optional) Select production model (default: gemini-2.5-flash):
#    GEMINI_MODEL=gemini-2.5-flash
#
# VERCEL DEPLOYMENT SETUP:
# In Vercel Project Settings -> Environment Variables:
# - Add GEMINI_API_KEY with your key value (Production & Preview)
# - (Optional) Add GEMINI_MODEL=gemini-2.5-flash
#
# DUAL-ENGINE FALLBACK RESILIENCE:
# If GEMINI_API_KEY is left blank or unset, SaansPatra seamlessly switches to its
# deterministic offline engine (CPCB piecewise interpolation + rule-based policy
# matrices) so that the application never crashes during live demos.
# ==============================================================================

# Required for Live Gemini AI Briefings (server-side only, never exposed to client):
GEMINI_API_KEY=

# Fast production Gemini model (stable defaults: gemini-2.5-flash or gemini-2.0-flash):
GEMINI_MODEL=gemini-2.5-flash
